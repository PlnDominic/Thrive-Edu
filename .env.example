# Supabase (admin CMS + storefront data) - see supabase/README.md for setup.
# /admin/signup is open to anyone who can reach it - every signed-in user
# gets full CMS read/write (no invite code, no roles table).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# expressPay Ghana (donations)
EXPRESSPAY_MERCHANT_ID=
EXPRESSPAY_API_KEY=
EXPRESSPAY_ENV=sandbox

# Contact form (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=
