# Supabase (admin CMS + storefront data) - see supabase/README.md for setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret required to create an admin account at /admin/signup. Every
# signed-in user gets full CMS read/write, so keep this private - share it
# only with people who should have admin access. Unset disables signup.
ADMIN_INVITE_CODE=

# expressPay Ghana (donations)
EXPRESSPAY_MERCHANT_ID=
EXPRESSPAY_API_KEY=
EXPRESSPAY_ENV=sandbox

# Contact form (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=
